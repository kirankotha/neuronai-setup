your-domain.duckdns.org {
    request_body {
        max_size 0
    }

    handle /continue_config.yaml {
        root * /var/www/html
        file_server
    }

    handle {
        reverse_proxy localhost:3000 {
            flush_interval -1
            transport http {
                response_header_timeout 300s
                dial_timeout 30s
            }
        }
    }
}

:80 {
    redir https://{host}{uri} permanent
}
